{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": ["dist", ".claude"],
  "rules": {
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/switch-exhaustiveness-check": "error",
    "eslint/no-console": "error",
    "eslint/complexity": [
      "error",
      {
        "max": 20,
        "variant": "modified"
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/**"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["./**", "../**"],
                "message": "Import files under src/ with @/."
              },
              {
                "group": ["@/commands/**"],
                "message": "Only src/cli.ts imports a command. Move code that several commands share out of src/commands/."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/cli.ts"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["./**", "../**"],
                "message": "Import files under src/ with @/."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["test/**"],
      "rules": {
        "eslint/complexity": "off"
      }
    }
  ]
}
