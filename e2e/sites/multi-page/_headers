# Applies to every path
/*
  X-Frame-Options: DENY
  X-E2E-Block: root
  X-E2E-Multi: a
  X-E2E-Multi: b
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/assets/*.css
  # Wildcard inside a segment
  X-E2E-Css: yes
/guides/*
  X-E2E-Block: guides
/guides/:page
  X-E2E-Page: placeholder
/.well-known/apple-app-site-association
  Content-Type: application/json
/pricing.html
  Set-Cookie: e2e=1; Path=/
  cache-control: max-age=0
  Cache-Control: no-cache
  Basic-Auth: user:e2e-secret
  Content-Length: 1
  Server: e2e
